    {
      "name": "Installment Purchases",
      "description": "Compras parceladas no cartão de crédito. Criar uma gera um lançamento por parcela; a busca mostra qual parcela de cada compra está ativa em um determinado mês (ex.: \"5/12\").",
      "item": [
        {
          "name": "Search Installment Purchases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/installment-purchases?month=2026-06-01&creditCardId={{creditCardId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "installment-purchases" ],
              "query": [
                { "key": "month", "value": "2026-06-01" },
                { "key": "creditCardId", "value": "{{creditCardId}}" }
              ]
            },
            "description": "`month` é opcional (padrão: mês atual) — qualquer data dentro do mês desejado serve. `creditCardId` também é opcional."
          },
          "response": []
        },
        {
          "name": "Create Installment Purchase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('installmentPurchaseId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Notebook Dell\",\n  \"totalAmount\": 3600.00,\n  \"currencyCode\": \"USD\",\n  \"installmentCount\": 12,\n  \"categoryId\": \"{{categoryId}}\",\n  \"creditCardId\": \"{{creditCardId}}\",\n  \"description\": \"Compra parcelada\",\n  \"firstInstallmentReleasedOnUtc\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/installment-purchases",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "installment-purchases" ]
            },
            "description": "`firstInstallmentReleasedOnUtc` é opcional: se omitido (ou `null`), usa o próximo vencimento do cartão. Se informado, tem que ser igual ou posterior a esse vencimento — útil para promoções do tipo \"pague só a partir de X\"."
          },
          "response": []
        },
        {
          "name": "Get Installment Purchase By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/installment-purchases/{{installmentPurchaseId}}",
              "host": [ "{{baseUrl}}" ],
